{
  "name": "TabGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "collapsed": {
      "type": "boolean",
      "default": false
    },
    "tabIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "saved": {
      "type": "boolean",
      "default": false
    },
    "position": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}